# Copia este archivo como .env y rellena lo que necesites. Todo es opcional:
# lo normal es configurar el modelo con `npm run config` (se guarda en data/config.json).
# Estas variables tienen prioridad sobre data/config.json.

# Modelo: ollama | lmstudio | llamacpp | vllm | openrouter | opencode | custom
# SHIRO_LLM_PROVIDER=ollama
# SHIRO_LLM_MODEL=qwen3:8b
# SHIRO_LLM_BASE_URL=http://localhost:11434
# SHIRO_LLM_API_KEY=

# Claves por proveedor (alternativa a SHIRO_LLM_API_KEY)
# OPENROUTER_API_KEY=
# OPENCODE_API_KEY=

# Servidor web
# PORT=1406
# BIND_HOST=127.0.0.1          # 0.0.0.0 para abrirlo a la red (exige contraseña)
# SHIRO_AUTH_TOKEN=            # contraseña de la web; si abres a la red sin ella, se genera una

# WhatsApp: número/chat que puede usar todas las herramientas (ej. 34600000000@c.us).
# Sin esto, Shiro responde a cualquiera pero solo con herramientas públicas.
# WA_ALLOWED_CHAT=
