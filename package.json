{
  "name": "Shiro",
  "version": "0.1.0",
  "description": "Proyecto pequeño inspirado en OpenClaw (base en construcción)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "shiro": "node --import tsx src/index.ts",
    "tui": "node --import tsx src/index.ts tui",
    "config": "node --import tsx src/index.ts config",
    "onboard": "node --import tsx src/index.ts onboard",
    "personalize": "node --import tsx src/index.ts personalize",
    "server": "node --import tsx src/index.ts server",
    "wa": "node --import tsx src/index.ts wa",
    "dev": "node --import tsx src/server.ts",
    "web": "node --import tsx src/server.ts",
    "test": "node --import tsx --test src/core/agent/ContextBuilder.test.ts src/core/health/LoopDetector.test.ts src/core/memory/Summarizer.test.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "better-sqlite3": "^12.6.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.1",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
