{
  "name": "shiro",
  "version": "0.2.0",
  "description": "Asistente de IA personal",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --import tsx src/index.ts app",
    "app": "node --import tsx src/index.ts app",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "tui": "node --import tsx src/index.ts tui",
    "wa": "node --import tsx src/index.ts wa",
    "doctor": "node --import tsx src/index.ts doctor",
    "mcp": "node --import tsx src/index.ts mcp",
    "exe": "node --import tsx src/buildExe.ts",
    "instalador": "node --import tsx src/buildExe.ts --instalador",
    "ayuda": "node --import tsx src/index.ts --help",
    "check": "tsc --noEmit -p .",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dompurify": "^3.4.16",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "puppeteer-core": "^24.38.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sql.js": "^1.11.0",
    "unpdf": "^1.8.1",
    "whatsapp-web.js": "^1.34.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.1",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
